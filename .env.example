# ==============================================================================
# TermiCode AI — Environment Configuration Template
# Copy this file to .env and adjust variables as needed:
#   copy .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# OPTION 1: Local LLM with Ollama (Recommended: 100% Offline, Free, Private)
# ------------------------------------------------------------------------------
# 1. Download and start Ollama from https://ollama.com
# 2. Download the recommended coding model:
#    ollama pull qwen2.5-coder:7b
# 3. Configure TermiCode to use Ollama:
TERMICODE_PROVIDER=ollama
TERMICODE_MODEL=qwen2.5-coder:7b
TERMICODE_API_BASE=http://localhost:11434/v1
TERMICODE_PROVIDER_TIMEOUT=120.0

# ------------------------------------------------------------------------------
# OPTION 2: OpenAI Cloud API (Requires OpenAI Account & Credits)
# ------------------------------------------------------------------------------
# TERMICODE_PROVIDER=openai
# TERMICODE_MODEL=gpt-4o
# OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# ------------------------------------------------------------------------------
# OPTION 3: Built-In Offline Mock Engine (Deterministic Zero-Cost Testing)
# ------------------------------------------------------------------------------
# TERMICODE_PROVIDER=fake

# ------------------------------------------------------------------------------
# Runtime & Safety Budget Settings
# ------------------------------------------------------------------------------
# Maximum tool steps allowed before agent halts (default: 10, max: 50)
TERMICODE_MAX_STEPS=15

# Maximum repair retries when tools encounter errors (default: 3)
TERMICODE_MAX_REPAIRS=3

# Subprocess command execution timeout in seconds (default: 30)
TERMICODE_COMMAND_TIMEOUT_SECONDS=30

# Subprocess stdout/stderr buffer cap in bytes (default: 65536 / 64 KB)
TERMICODE_MAX_COMMAND_OUTPUT_BYTES=65536

# Logging verbosity level (DEBUG, INFO, WARNING, ERROR)
TERMICODE_LOG_LEVEL=INFO
